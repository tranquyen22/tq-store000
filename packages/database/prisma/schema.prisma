datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ==========================================
// ENUMS (Tuân thủ theo packages/types)
// ==========================================

enum UserRole {
  CUSTOMER
  DRIVER
  SHOP_OWNER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum ShopServiceType {
  RENTAL
  FASHION
  FOOD_BEVERAGE
  BEAUTY
}

enum DriverServiceType {
  BIKE_TAXI
  CAR_TAXI
  EXPRESS_DELIVERY
  FOOD_DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum RideStatus {
  SEARCHING
  ACCEPTED
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WalletType {
  CUSTOMER_WALLET
  DRIVER_WALLET
  SHOP_WALLET
  PLATFORM_COMMISSION_WALLET
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  RIDE_PAYMENT
  ORDER_PAYMENT
  COMMISSION_DEDUCTION
  REFUND
  REWARD_XU
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  MASKED_VIEW
  APPROVE_SHOP
  SUSPEND_USER
  FINANCIAL_TRANSFER
}

enum SOSAlertStatus {
  TRIGGERED
  IN_REVIEW
  RESOLVED
  FALSE_ALARM
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PaymentMethod {
  COD
  MOMO_QR
  BANK_TRANSFER
  TQ_WALLET
}

// ==========================================
// MODELS & TABLES
// ==========================================

// 1. Users (Người dùng & Quản trị)
model User {
  id               String            @id @default(uuid())
  fullName         String            @map("full_name")
  email            String            @unique
  phone            String            @unique
  passwordHash     String            @map("password_hash")
  citizenId        String?           @unique @map("citizen_id")
  avatar           String?
  role             UserRole          @default(CUSTOMER)
  isVerified       Boolean           @default(false) @map("is_verified")
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  // Relations
  addresses        UserAddress[]
  shops            Shop[]
  driver           Driver?
  orders           Order[]
  rideBookings     RideBooking[]     @relation("CustomerRides")
  wallets          Wallet[]
  auditLogs        AuditLog[]        @relation("OperatorLogs")
  targetLogs       AuditLog[]        @relation("TargetLogs")
  staffPermissions StaffPermission[]
  sosAlerts        SOSAlert[]
  conversations    Conversation[]    @relation("UserConversations")
  messages         Message[]
  reviews          Review[]
  tickets          Ticket[]
  xuLogs           XuLog[]

  @@index([phone, email, role])
  @@map("users")
}

// 2. Staff Permissions (Phân quyền chi tiết cho nhân viên/Admin)
model StaffPermission {
  id          String   @id @default(uuid())
  staffId     String   @map("staff_id")
  permission  String
  grantedBy   String   @map("granted_by")
  createdAt   DateTime @default(now()) @map("created_at")

  staff       User     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, permission])
  @@map("staff_permissions")
}

// 3. Audit Logs (Bắt buộc lưu vết lịch sử mọi hành vi Admin/Staff)
model AuditLog {
  id            String      @id @default(uuid())
  operatorId    String      @map("operator_id")
  targetUserId  String?     @map("target_user_id")
  action        AuditAction
  resource      String
  ipAddress     String?     @map("ip_address")
  userAgent     String?     @map("user_agent")
  oldValues     Json?       @map("old_values")
  newValues     Json?       @map("new_values")
  createdAt     DateTime    @default(now()) @map("created_at")

  operator      User        @relation("OperatorLogs", fields: [operatorId], references: [id])
  targetUser    User?       @relation("TargetLogs", fields: [targetUserId], references: [id])

  @@index([operatorId, action, createdAt])
  @@map("audit_logs")
}

// 4. Provinces (Tỉnh / Thành phố)
model Province {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  name      String
  districts District[]

  @@map("provinces")
}

// 5. Districts (Quận / Huyện)
model District {
  id         Int           @id @default(autoincrement())
  provinceId Int           @map("province_id")
  code       String        @unique
  name       String
  province   Province      @relation(fields: [provinceId], references: [id])
  addresses  UserAddress[]

  @@map("districts")
}

// 6. User Addresses (Địa chỉ giao hàng & vị trí)
model UserAddress {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  districtId   Int?     @map("district_id")
  receiverName String   @map("receiver_name")
  phone        String
  addressLine  String   @map("address_line")
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  district     District? @relation(fields: [districtId], references: [id])

  @@map("user_addresses")
}

// 7. Shops (Gian hàng Thương mại & Dịch vụ Cho thuê/Food/Làm đẹp)
model Shop {
  id            String          @id @default(uuid())
  ownerId       String          @map("owner_id")
  name          String
  slug          String          @unique
  logo          String?
  banner        String?
  serviceType   ShopServiceType @map("service_type")
  rating        Float           @default(5.0)
  isApproved    Boolean         @default(false) @map("is_approved")
  isOfficial    Boolean         @default(false) @map("is_official")
  phone         String
  address       String
  latitude      Float?
  longitude     Float?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  owner         User            @relation(fields: [ownerId], references: [id])
  categories    Category[]
  products      Product[]
  orders        Order[]

  @@index([ownerId, serviceType, isApproved])
  @@map("shops")
}

// 8. Categories (Danh mục sản phẩm)
model Category {
  id        String   @id @default(uuid())
  shopId    String?  @map("shop_id")
  name      String
  slug      String   @unique
  icon      String?
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")

  shop      Shop?      @relation(fields: [shopId], references: [id])
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]

  @@map("categories")
}

// 9. Products (Sản phẩm TMĐT, Đồ ăn, Mỹ phẩm & Đồ thuê)
model Product {
  id            String         @id @default(uuid())
  shopId        String         @map("shop_id")
  categoryId    String         @map("category_id")
  name          String
  slug          String         @unique
  price         Decimal        @db.Decimal(12, 2)
  originalPrice Decimal?       @map("original_price") @db.Decimal(12, 2)
  inStock       Int            @default(10) @map("in_stock")
  rating        Float          @default(5.0)
  reviewsCount  Int            @default(0) @map("reviews_count")
  badge         String?
  description   String         @db.Text
  specs         Json?
  isAvailable   Boolean        @default(true) @map("is_available")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  shop          Shop           @relation(fields: [shopId], references: [id])
  category      Category       @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  orderItems    OrderItem[]
  reviews       Review[]

  @@index([shopId, categoryId, isAvailable])
  @@map("products")
}

// 10. Product Images (Hình ảnh sản phẩm)
model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  imageUrl  String   @map("image_url")
  isPrimary Boolean  @default(false) @map("is_primary")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// 11. Drivers (Tài xế Taxi, Xe ôm & Shipper)
model Driver {
  id            String            @id @default(uuid())
  userId        String            @unique @map("user_id")
  serviceType   DriverServiceType @map("service_type")
  licensePlate  String            @unique @map("license_plate")
  vehicleType   String            @map("vehicle_type")
  rating        Float             @default(5.0)
  isOnline      Boolean           @default(false) @map("is_online")
  isBusy        Boolean           @default(false) @map("is_busy")
  currentLat    Float?            @map("current_lat")
  currentLng    Float?            @map("current_lng")
  walletBalance Decimal           @default(0) @map("wallet_balance") @db.Decimal(12, 2)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  user          User              @relation(fields: [userId], references: [id])
  rideBookings  RideBooking[]     @relation("DriverRides")
  sosAlerts     SOSAlert[]

  @@index([isOnline, isBusy, serviceType])
  @@map("drivers")
}

// 12. Ride Bookings (Đặt xe Taxi / Xe ôm / Giao hàng)
model RideBooking {
  id             String      @id @default(uuid())
  customerId     String      @map("customer_id")
  driverId       String?     @map("driver_id")
  pickupAddress  String      @map("pickup_address")
  pickupLat      Float       @map("pickup_lat")
  pickupLng      Float       @map("pickup_lng")
  dropoffAddress String      @map("dropoff_address")
  dropoffLat     Float       @map("dropoff_lat")
  dropoffLng     Float       @map("dropoff_lng")
  distanceKm     Float       @map("distance_km")
  fareAmount     Decimal     @map("fare_amount") @db.Decimal(12, 2)
  status         RideStatus  @default(SEARCHING)
  paymentMethod  PaymentMethod @default(COD) @map("payment_method")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  customer       User        @relation("CustomerRides", fields: [customerId], references: [id])
  driver         Driver?     @relation("DriverRides", fields: [driverId], references: [id])
  sosAlerts      SOSAlert[]

  @@index([customerId, driverId, status])
  @@map("ride_bookings")
}

// 13. SOS Alerts (Báo động khẩn cấp SOS cho Tài xế / Khách hàng)
model SOSAlert {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  driverId      String?        @map("driver_id")
  rideId        String?        @map("ride_id")
  latitude      Float
  longitude     Float
  status        SOSAlertStatus @default(TRIGGERED)
  note          String?
  createdAt     DateTime       @default(now()) @map("created_at")
  resolvedAt    DateTime?      @map("resolved_at")

  user          User           @relation(fields: [userId], references: [id])
  driver        Driver?        @relation(fields: [driverId], references: [id])
  ride          RideBooking?   @relation(fields: [rideId], references: [id])

  @@map("sos_alerts")
}

// 14. Orders (Đơn hàng TMĐT, F&B & Đồ thuê)
model Order {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  shopId          String        @map("shop_id")
  customerName    String        @map("customer_name")
  customerPhone   String        @map("customer_phone")
  customerEmail   String?       @map("customer_email")
  shippingAddress String        @map("shipping_address")
  paymentMethod   PaymentMethod @default(COD) @map("payment_method")
  subtotal        Decimal       @db.Decimal(12, 2)
  shippingFee     Decimal       @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  status          OrderStatus   @default(PENDING)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user            User          @relation(fields: [userId], references: [id])
  shop            Shop          @relation(fields: [shopId], references: [id])
  items           OrderItem[]
  taxInvoice      TaxInvoice?

  @@index([userId, shopId, status])
  @@map("orders")
}

// 15. Order Items (Chi tiết từng mặt hàng trong đơn)
model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  productId   String   @map("product_id")
  productName String   @map("product_name")
  price       Decimal  @db.Decimal(12, 2)
  quantity    Int
  image       String?

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// 16. Vouchers (Mã giảm giá Khuyến mãi)
model Voucher {
  id             String    @id @default(uuid())
  code           String    @unique
  discountPercent Float?   @map("discount_percent")
  discountAmount Decimal?  @map("discount_amount") @db.Decimal(12, 2)
  minOrderValue  Decimal   @default(0) @map("min_order_value") @db.Decimal(12, 2)
  isFreeShip     Boolean   @default(false) @map("is_free_ship")
  maxUsage       Int       @default(100) @map("max_usage")
  usedCount      Int       @default(0) @map("used_count")
  expiredAt      DateTime  @map("expired_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("vouchers")
}

// 17. Wallets (Ví điện tử - Chuẩn Kế toán kép Double-Entry)
model Wallet {
  id           String              @id @default(uuid())
  userId       String              @map("user_id")
  walletType   WalletType          @map("wallet_type")
  balance      Decimal             @default(0) @db.Decimal(12, 2)
  currency     String              @default("VND")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id])
  debitTxns    WalletTransaction[] @relation("DebitWallet")
  creditTxns   WalletTransaction[] @relation("CreditWallet")

  @@unique([userId, walletType])
  @@map("wallets")
}

// 18. Wallet Transactions (Lịch sử giao dịch ví - Atomic Lock & Double-Entry)
model WalletTransaction {
  id              String          @id @default(uuid())
  debitWalletId   String          @map("debit_wallet_id")
  creditWalletId  String          @map("credit_wallet_id")
  amount          Decimal         @db.Decimal(12, 2)
  type            TransactionType
  referenceId     String?         @map("reference_id")
  description     String
  createdAt       DateTime        @default(now()) @map("created_at")

  debitWallet     Wallet          @relation("DebitWallet", fields: [debitWalletId], references: [id])
  creditWallet    Wallet          @relation("CreditWallet", fields: [creditWalletId], references: [id])

  @@index([debitWalletId, creditWalletId, type])
  @@map("wallet_transactions")
}

// 19. Xu Logs (Tích điểm Xu thưởng TQ Store)
model XuLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  amount      Int
  balance     Int
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id])

  @@map("xu_logs")
}

// 20. Tax Invoices (Hóa đơn tài chính VAT)
model TaxInvoice {
  id           String   @id @default(uuid())
  orderId      String   @unique @map("order_id")
  companyName  String   @map("company_name")
  taxCode      String   @map("tax_code")
  address      String
  email        String
  amount       Decimal  @db.Decimal(12, 2)
  issuedAt     DateTime @default(now()) @map("issued_at")

  order        Order    @relation(fields: [orderId], references: [id])

  @@map("tax_invoices")
}

// 21. Conversations (Hộp thoại Chat Khách - Shop / Tài xế)
model Conversation {
  id        String    @id @default(uuid())
  title     String?
  createdAt DateTime  @default(now()) @map("created_at")

  users     User[]    @relation("UserConversations")
  messages  Message[]

  @@map("conversations")
}

// 22. Messages (Tin nhắn Chat Realtime)
model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  senderId       String       @map("sender_id")
  content        String       @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@map("messages")
}

// 23. Reviews (Đánh giá Đầm thuê, Đồ ăn, Mỹ phẩm & Tài xế)
model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String?  @map("product_id")
  rating    Int      @default(5)
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])
  product   Product? @relation(fields: [productId], references: [id])

  @@map("reviews")
}

// 24. Tickets (Hỗ trợ CSKH & Khiếu nại)
model Ticket {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  subject     String
  description String       @db.Text
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id])

  @@map("tickets")
}

// 25. System Configurations (Cấu hình hệ thống động)
model SystemConfiguration {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configurations")
}
