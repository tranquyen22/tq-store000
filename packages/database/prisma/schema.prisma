generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  fullName     String    @map("full_name")
  email        String    @unique
  phone        String    @unique
  passwordHash String    @map("password_hash")
  role         String    @default("customer")
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  addresses    UserAddress[]
  shops        Shop[]
  drivers      Driver[]
  orders       Order[]
  wallets      Wallet[]
  xuLogs       XuLog[]
  messages     Message[]
  reviews      Review[]
  tickets      Ticket[]
  staffPerms   StaffPermission[]
  conversations Conversation[] @relation("UserConversations")

  @@map("users")
}

model StaffPermission {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  permission String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_permissions")
}

model AuditLog {
  id           String   @id @default(uuid())
  operatorId   String   @map("operator_id")
  operatorRole String   @map("operator_role")
  action       String
  resource     String
  ipAddress    String   @map("ip_address")
  oldValues    String?  @map("old_values")
  newValues    String?  @map("new_values")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Province {
  code      String     @id
  name      String
  districts District[]

  @@map("provinces")
}

model District {
  code         String     @id
  provinceCode String     @map("province_code")
  name         String
  province     Province   @relation(fields: [provinceCode], references: [code])
  addresses    UserAddress[]
  shops        Shop[]

  @@map("districts")
}

model UserAddress {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  districtCode String   @map("district_code")
  fullAddress  String   @map("full_address")
  isDefault    Boolean  @default(false) @map("is_default")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  district     District @relation(fields: [districtCode], references: [code])

  @@map("user_addresses")
}

model Shop {
  id           String    @id @default(uuid())
  ownerId      String    @map("owner_id")
  name         String
  serviceType  String    @map("service_type")
  phone        String
  address      String
  districtCode String    @map("district_code")
  isOpen       Boolean   @default(true) @map("is_open")
  rating       Float     @default(5.0)
  owner        User      @relation(fields: [ownerId], references: [id])
  district     District  @relation(fields: [districtCode], references: [code])
  categories   Category[]
  products     Product[]
  orders       Order[]

  @@map("shops")
}

model Category {
  id       String    @id @default(uuid())
  shopId   String    @map("shop_id")
  name     String
  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("categories")
}

model Product {
  id           String    @id @default(uuid())
  shopId       String    @map("shop_id")
  categoryId   String    @map("category_id")
  name         String
  price        Decimal   @db.Decimal(12, 2)
  depositPrice Decimal?  @default(0) @map("deposit_price") @db.Decimal(12, 2)
  rating       Float     @default(5.0)
  reviewsCount Int       @default(0) @map("reviews_count")
  shop         Shop      @relation(fields: [shopId], references: [id])
  category     Category  @relation(fields: [categoryId], references: [id])
  images       ProductImage[]
  reviews      Review[]

  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  imageUrl  String  @map("image_url")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Driver {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  serviceType  String   @map("service_type")
  vehiclePlate String   @map("vehicle_plate")
  isOnline     Boolean  @default(false) @map("is_online")
  user         User     @relation(fields: [userId], references: [id])
  rides        RideBooking[]

  @@map("drivers")
}

model RideBooking {
  id          String   @id @default(uuid())
  driverId    String?  @map("driver_id")
  pickupName  String   @map("pickup_name")
  dropoffName String   @map("dropoff_name")
  fare        Decimal  @db.Decimal(12, 2)
  status      String   @default("SEARCHING")
  createdAt   DateTime @default(now()) @map("created_at")
  driver      Driver?  @relation(fields: [driverId], references: [id])

  @@map("ride_bookings")
}

model SosAlert {
  id        String   @id @default(uuid())
  senderId  String   @map("sender_id")
  status    String   @default("PENDING")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sos_alerts")
}

model Order {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  shopId    String   @map("shop_id")
  status    String   @default("PENDING")
  total     Decimal  @db.Decimal(12, 2)
  discount  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  shop      Shop     @relation(fields: [shopId], references: [id])
  items     OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Voucher {
  id          String   @id @default(uuid())
  code        String   @unique
  discount    Decimal  @db.Decimal(12, 2)
  minOrder    Decimal  @map("min_order") @db.Decimal(12, 2)
  isAvailable Boolean  @default(true) @map("is_available")

  @@map("vouchers")
}

model Wallet {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  walletType String   @map("wallet_type")
  balance    Decimal  @default(0) @db.Decimal(12, 2)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletTransaction {
  id             String   @id @default(uuid())
  debitWalletId  String   @map("debit_wallet_id")
  creditWalletId String   @map("credit_wallet_id")
  amount         Decimal  @db.Decimal(12, 2)
  type           String
  description    String
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("wallet_transactions")
}

model XuLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  amount      Int
  balance     Int
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("xu_logs")
}

model TaxInvoice {
  id         String   @id @default(uuid())
  targetId   String   @map("target_id")
  taxAmount  Decimal  @map("tax_amount") @db.Decimal(12, 2)
  period     String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("tax_invoices")
}

model Conversation {
  id        String    @id @default(uuid())
  title     String
  createdAt DateTime  @default(now()) @map("created_at")
  users     User[]    @relation("UserConversations")
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  senderId       String       @map("sender_id")
  content        String
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@map("messages")
}

model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@map("reviews")
}

model Ticket {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  subject     String
  description String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id])

  @@map("tickets")
}

model SystemConfiguration {
  id         String @id @default(uuid())
  key        String @unique
  value      String

  @@map("system_configurations")
}
